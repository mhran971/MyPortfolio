{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eng-mahranabodakka-myportfolio",
  "compatibility_date": "2026-08-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      "node_modules/**",
      "tests/**",
      ".git/**",
      ".github/**",
      "Dockerfile",
      ".dockerignore",
      "package.json",
      "package-lock.json"
    ]
  }
}
